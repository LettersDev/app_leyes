// supabase/functions/generate-daily-quiz/index.ts
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

const GEMINI_API_KEY    = Deno.env.get('GEMINI_API_KEY') ?? '';
const EXPO_ACCESS_TOKEN = Deno.env.get('EXPO_ACCESS_TOKEN') ?? ''; // Opcional

const GEMINI_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${GEMINI_API_KEY}`;

Deno.serve(async (req) => {
    try {
        const supabase = createClient(
            Deno.env.get('SUPABASE_URL')!,
            Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!
        );

        // 1. Determinar si es Test y si hay un Target Token
        // Usamos la URL para evitar problemas de "body already consumed"
        const url = new URL(req.url);
        const isTest = url.searchParams.get('test') === 'true';
        const targetToken = url.searchParams.get('targetToken');

        // ... (Aquí iría toda la lógica de generación que ya funciona) ...
        // Simplificaré para ir al grano con las notificaciones:
        
        console.log(`[Quiz] Iniciando generación. Test: ${isTest}, Target: ${targetToken || 'Todos'}`);

        // [ESTO ES UN MOCK DEL CONTENIDO PARA EL EJEMPLO DE NOTIFICACIÓN]
        // En tu código real, aquí se genera la pregunta con Gemini.
        const questionPreview = "Nueva evaluación legal diaria disponible.";

        // 2. Lógica de Notificaciones Robusta
        let tokens: string[] = [];

        if (targetToken) {
            tokens = [targetToken];
            console.log(`[Quiz] Enviando notificación de PRUEBA a: ${targetToken}`);
        } else if (!isTest) {
            const { data: rows } = await supabase.from('push_tokens').select('token');
            tokens = (rows ?? []).map(r => r.token);
            console.log(`[Quiz] Enviando a producción: ${tokens.length} tokens`);
        }

        if (tokens.length > 0) {
            const preview = questionPreview.length > 80 ? questionPreview.substring(0, 77) + '...' : questionPreview;
            const messages = tokens.map(token => ({
                to: token,
                title: '🤖 Pregunta Legal del Día',
                body: preview,
                data: { screen: 'DailyQuiz' },
                sound: 'default',
            }));

            // Enviar a Expo
            const res = await fetch('https://exp.host/--/api/v2/push/send', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(EXPO_ACCESS_TOKEN ? { 'Authorization': `Bearer ${EXPO_ACCESS_TOKEN}` } : {}),
                },
                body: JSON.stringify(messages),
            });
            
            console.log(`[Quiz] Resultado Expo: ${res.status}`);
        }

        return new Response(JSON.stringify({ ok: true, sent: tokens.length }), { headers: { 'Content-Type': 'application/json' } });

    } catch (err) {
        return new Response(JSON.stringify({ error: err.message }), { status: 500 });
    }
});
